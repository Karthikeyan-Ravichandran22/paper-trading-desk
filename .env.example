# Application
APP_NAME=Angel One Paper Trading Dashboard
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./data/paper_trading.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Trading mode — PAPER is the only enabled mode for week-1 experiment
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Paper portfolio defaults
DEFAULT_STARTING_CAPITAL=100000
DEFAULT_SLIPPAGE_BPS=5
DEFAULT_BROKERAGE_PER_ORDER=20

# Angel One SmartAPI (server-side only — never expose to frontend)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
ANGEL_FEED_TOKEN=
ANGEL_JWT_TOKEN=
ANGEL_REFRESH_TOKEN=

# Demo market data when Angel One is not configured
USE_DEMO_MARKET_DATA=true
DEMO_SYMBOLS=NIFTY,BANKNIFTY,RELIANCE,TCS,INFY

# Auth (simple session for dashboard)
ADMIN_USERNAME=trader
ADMIN_PASSWORD=paper-trade-only
